# Multi-stage build for Rust CertStream Server
FROM rust:1.75-slim as builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy manifests
COPY Cargo.toml ./

# Copy source code
COPY src ./src

# Build for release
RUN cargo build --release

# Runtime stage
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy binary from builder
COPY --from=builder /build/target/release/certstream-server /app/certstream-server

# Copy frontend files
COPY frontend /app/frontend

# Expose default port
EXPOSE 4000

# Set environment variables
ENV PORT=4000
ENV LOG_LEVEL=info

# Run the server
CMD ["/app/certstream-server"]
